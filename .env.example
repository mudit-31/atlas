# Required -------------------------------------------------------------
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Free Tavily key (1,000 credits/month): https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Models (optional) ----------------------------------------------------
# ATLAS_WRITER_MODEL=gemini-3.5-flash-lite
# ATLAS_VERIFIER_MODEL=gemini-3.5-flash-lite
# ATLAS_EXTRACTOR_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is missing or out of daily quota:
# ATLAS_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional Gemini 3 thinking level (e.g. low) to cut latency and tokens:
# ATLAS_THINKING_LEVEL=

# Free-tier protection (optional) -------------------------------------
# Max Gemini requests per minute from this machine:
# GEMINI_RPM=10
# ATLAS_CACHE=true
# ATLAS_CACHE_DIR=data/cache

# Pipeline sizing (optional) ------------------------------------------
# ATLAS_MAX_SOURCES=6
# ATLAS_SEARCH_DEPTH=basic
# ATLAS_MAX_CLAIMS=25
# ATLAS_VERIFY_BATCH_SIZE=12
# ATLAS_EVIDENCE_PER_CLAIM=4
